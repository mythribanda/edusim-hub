# generate with: python -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET=replace-with-a-strong-random-secret


# Comma-separated list of allowed CORS origins.
# Defaults to http://localhost:5173 when unset (local dev only).
# Example for production: ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
ALLOWED_ORIGINS=http://localhost:8080

# Google OAuth Client Credentials
# Create these in the Google Cloud Console under Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# OpenRouter API Key for AI Tutor and Explanation Generators
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Resend API Key for transactional email (weekly digest, notifications)
# Sign up at https://resend.com — free tier: 100 emails/day, 3,000/month
RESEND_API_KEY=re_your_resend_api_key_here

# Sender address shown in digest emails (must be verified in Resend dashboard)
DIGEST_FROM_EMAIL=EduSim Hub <digest@yourdomain.com>
