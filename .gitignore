# ==============================================================================
# EduSim Monorepo .gitignore
# Excludes unnecessary runtime artifacts, dependencies, caches, environment configs,
# build outputs, and temporary testing files for both Frontend and Backend.
# ==============================================================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.env
*.env.*
*.pem
*.key
*.cert

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDE & Editor Files ---
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# --- Logs & Monitoring ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
# Backend (Python / FastAPI / RAG / SQLite)
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# SQLite Databases & Local Storage
*.db
*.sqlite
*.sqlite3
backend/edusim.db
backend/uploads/
uploads/

# Raw / Unprocessed RAG PDFs & Temp Data Caches
backend/faiss_index/
backend/data/*.json
backend/data/generated_simulations.json
backend/data/formula_extraction_cache.json

# Scratch & Temporary Audit Scripts
scratch/
*/scratch/
backend/scratch/
frontend/scratch/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Packaging & Distribution
*.egg-info/
*.egg
dist/
build/
eggs/
.eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
share/python-wheels/

# ==============================================================================
# Frontend (React / Vite / TypeScript / TanStack)
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
frontend/node_modules/

# Build Outputs & Bundler Caches
dist/
build/
out/
.output/
.parcel-cache/
.turbo/
frontend/dist/
frontend/build/
frontend/.output/

# Framework & Tool Caches
.vite/
*/.vite/
frontend/.vite/
.tanstack/
*/.tanstack/
frontend/.tanstack/
.wrangler/
*/.wrangler/
frontend/.wrangler/

# TypeScript Build Info
*.tsbuildinfo
frontend/*.tsbuildinfo

# Package Manager Lockfiles (Uncomment if ignoring, default tracks lockfiles)
# package-lock.json
# bun.lockb
# yarn.lock
# pnpm-lock.yaml
